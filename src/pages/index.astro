---
import Layout from "../layouts/Layout.astro";
import fs from "node:fs";
import path from "node:path";

const dataPath = path.join(process.cwd(), "public/data/aggregated.json");
const raw = fs.readFileSync(dataPath, "utf-8");
const { national, byDept, timeline, meta } = JSON.parse(raw);
const base = import.meta.env.BASE_URL;

// Top 5 depts by pct cumul (k>=5)
const topCumul = [...byDept].filter(d=>!d.kAnonyme).sort((a,b)=>b.pctCumulLarge - a.pctCumulLarge).slice(0,5);
const lowCumul = [...byDept].filter(d=>!d.kAnonyme).sort((a,b)=>a.pctCumulLarge - b.pctCumulLarge).slice(0,5);
---

<Layout title="Cumuloscope — Explorer le cumul des mandats (Ve République)" description="510 000 élus, 13.5% en cumul large. Explorez votre département, la timeline 1958-2026 et testez vos connaissances. Données officielles RNE/HATVP.">
  <!-- HERO -->
  <section class="bg-gradient-to-br from-cumulo-blue to-cumulo-blue-light text-white">
    <div class="max-w-6xl mx-auto px-4 py-10 md:py-14">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <p class="inline-flex items-center gap-2 text-xs uppercase tracking-widest bg-white/15 rounded-full px-3 py-1">Données officielles • MAJ {meta.updated} • Licence Ouverte 2.0</p>
          <h1 class="mt-4 text-3xl md:text-4xl font-extrabold leading-tight">Le cumul des mandats,<br/>enfin lisible.</h1>
          <p class="mt-3 text-white/80">Ve République (1958–2026). Vision <strong class="text-white">large</strong> par défaut (≥2 mandats simultanés) + filtre <strong class="text-white">interdit loi 2014</strong>. Agrégats anonymisés, pédagogie avant jugement.</p>

          <!-- Recherche code postal / dept -->
          <div class="mt-6 bg-white rounded-2xl p-2 flex gap-2 shadow-xl">
            <input id="dept-search" type="text" placeholder="Code postal, département (ex: 59, 75001, 2A) ou nom" class="flex-1 px-4 py-2.5 rounded-xl text-slate-900 outline-none" />
            <button id="dept-go" class="px-5 py-2.5 rounded-xl bg-cumulo-accent text-slate-900 font-semibold hover:bg-cumulo-accent-hover">Explorer →</button>
          </div>
          <p class="mt-2 text-xs text-white/60">Exemple: tapez <button data-example="59" class="underline example-btn">59</button>, <button data-example="75" class="underline example-btn">75</button>, <button data-example="971" class="underline example-btn">971</button> ou <button data-example="Lyon" class="underline example-btn">Rhône</button>. Aucun nom affiché par défaut.</p>
          <div class="mt-4 flex flex-wrap gap-2 text-xs">
            <span class="px-2 py-1 rounded-full bg-white/15">✓ k-anonymat ≥5</span>
            <span class="px-2 py-1 rounded-full bg-white/15">✓ Sans tracking</span>
            <span class="px-2 py-1 rounded-full bg-white/15">✓ Partage anonyme</span>
          </div>
        </div>
        <div class="bg-white text-slate-900 rounded-2xl p-5 shadow-xl">
          <div class="grid grid-cols-3 gap-4 text-center">
            <div>
              <p class="text-2xl font-extrabold text-cumulo-blue">{national.totalElus.toLocaleString('fr-FR')}</p>
              <p class="text-xs text-slate-500">élus uniques<br/>(RNE 2026)</p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-cumulo-blue">{national.pctCumulLarge}%</p>
              <p class="text-xs text-slate-500">en cumul large<br/>≥2 mandats</p>
            </div>
            <div>
              <p class="text-2xl font-extrabold text-emerald-600">{national.pctInterdit2014}%</p>
              <p class="text-xs text-slate-500">interdit loi 2014<br/>parl.+exécutif</p>
            </div>
          </div>
          <div class="mt-4 p-3 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900">
            <strong>Lecture:</strong> 1 élu sur {Math.round(100/national.pctCumulLarge)} cumule ≥2 mandats. Après 2017, le cumul parlementaire+exécutif est quasi résiduel ({national.pctInterdit2014}% — 304 cas détectés).
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
            <a href={`${base}quiz/`} class="rounded-xl bg-cumulo-blue text-white text-center py-2.5 font-semibold">Faire le quiz →</a>
            <button id="share-home" class="rounded-xl border border-slate-200 py-2.5 font-semibold hover:bg-slate-50">Partager ma carte</button>
          </div>
          <p class="mt-2 text-[10px] text-slate-500 text-center">Couverture: {meta.couverture}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CARTE + TIMELINE -->
  <section class="max-w-6xl mx-auto px-4 py-8 grid lg:grid-cols-5 gap-6">
    <div class="lg:col-span-3 bg-white rounded-2xl border border-cumulo-border p-4">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-cumulo-blue">Carte par département — agrégats anonymisés</h2>
        <span class="text-xs px-2 py-1 rounded-full bg-slate-100">k ≥5</span>
      </div>
      <p class="text-xs text-slate-500 mt-1">Couleur = % cumul large. Cliquez pour le détail anonyme. Noms uniquement après consentement.</p>
      <div id="map" class="mt-3 h-[380px] rounded-xl border border-slate-200 bg-slate-50"></div>
      <div class="mt-2 flex items-center gap-2 text-[10px] text-slate-500">
        <span class="w-3 h-3 bg-[#fee8c8] border"></span> &lt;10%
        <span class="w-3 h-3 bg-[#fdbb84] border"></span> 10–14%
        <span class="w-3 h-3 bg-[#fc8d59] border"></span> 14–18%
        <span class="w-3 h-3 bg-[#ef6548] border"></span> 18%+
        <span class="ml-auto">Source: RNE 11/08/2026</span>
      </div>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl border border-cumulo-border p-4 flex flex-col">
      <h2 class="font-bold text-cumulo-blue">Timeline 1958–2026</h2>
      <p class="text-xs text-slate-500">% nationaux en cumul. Points 2012/2017 = ruptures.</p>
      <div class="mt-3 flex-1 min-h-[240px]">
        <canvas id="timelineChart" height="220"></canvas>
      </div>
      <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
        <div class="p-2 rounded-xl bg-slate-50 border"><strong>1958-85</strong> illimité → 78% cumul</div>
        <div class="p-2 rounded-xl bg-slate-50 border"><strong>1985/2000</strong> max 2 mandats</div>
        <div class="p-2 rounded-xl bg-amber-50 border border-amber-200"><strong>2014/2017</strong> parl.+exécutif interdit → 0.1%</div>
        <div class="p-2 rounded-xl bg-emerald-50 border border-emerald-200"><strong>2026</strong> 13.5% large, 0.1% interdit</div>
      </div>
      <a href={`${base}histoire/`} class="mt-3 text-xs underline text-cumulo-blue">Voir l'histoire détaillée →</a>
    </div>
  </section>

  <!-- CLASSEMENTS ANONYMES -->
  <section class="max-w-6xl mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl border border-cumulo-border p-4">
        <h3 class="font-semibold text-cumulo-blue">Départements — % cumul le plus élevé</h3>
        <p class="text-xs text-slate-500">Agrégats uniquement, jamais de noms ici.</p>
        <ul class="mt-3 divide-y text-sm">
          {topCumul.map(d => (
            <li class="flex items-center justify-between py-2">
              <a href={`${base}departement/${d.code}/`} class="flex items-center gap-2 hover:underline"><span class="w-8 text-xs font-mono bg-slate-100 rounded px-1 py-0.5 text-center">{d.code}</span> {d.libelle}</a>
              <span class="font-mono font-semibold">{d.pctCumulLarge}% <span class="text-xs font-normal text-slate-500">({d.effectifCumul})</span></span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white rounded-2xl border border-cumulo-border p-4">
        <h3 class="font-semibold text-cumulo-blue">Départements — % cumul le plus faible</h3>
        <p class="text-xs text-slate-500">Là aussi, que des %.</p>
        <ul class="mt-3 divide-y text-sm">
          {lowCumul.map(d => (
            <li class="flex items-center justify-between py-2">
              <a href={`${base}departement/${d.code}/`} class="flex items-center gap-2 hover:underline"><span class="w-8 text-xs font-mono bg-slate-100 rounded px-1 py-0.5 text-center">{d.code}</span> {d.libelle}</a>
              <span class="font-mono font-semibold">{d.pctCumulLarge}%</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- QUIZ + BADGES + SIMULATEUR -->
  <section class="max-w-6xl mx-auto px-4 mt-6 grid md:grid-cols-3 gap-6">
    <a href={`${base}quiz/`} class="bg-cumulo-accent rounded-2xl p-5 border border-amber-200 hover:shadow-md block">
      <p class="text-xs uppercase tracking-widest">Gamification sobre</p>
      <h3 class="font-bold text-lg">Quiz du jour — 3 questions</h3>
      <p class="text-sm mt-1">Testez la loi 2014 sans afficher un seul nom. Streak + badges en localStorage.</p>
      <p class="mt-3 inline-flex px-3 py-1.5 bg-slate-900 text-white rounded-full text-xs font-semibold">Jouer →</p>
      <p class="mt-2 text-xs">Badges: <span id="badge-count">0</span>/6 • Streak: <span id="streak-count">0</span> jours</p>
    </a>
    <div class="bg-white rounded-2xl border border-cumulo-border p-5">
      <h3 class="font-bold text-cumulo-blue">Simulateur “Et si vous étiez élu ?”</h3>
      <div class="mt-3 space-y-2 text-sm">
        <select id="simu1" class="w-full border rounded-xl px-3 py-2"><option value="">Mandat 1</option><option value="dep">Député</option><option value="sen">Sénateur</option><option value="mai">Maire</option><option value="cd">Président département</option><option value="cr">Président région</option><option value="cm">Conseiller municipal</option></select>
        <select id="simu2" class="w-full border rounded-xl px-3 py-2"><option value="">Mandat 2</option><option value="dep">Député</option><option value="sen">Sénateur</option><option value="mai">Maire</option><option value="cd">Président département</option><option value="cr">Président région</option><option value="cm">Conseiller municipal</option></select>
        <button id="simu-go" class="w-full bg-cumulo-blue text-white rounded-xl py-2 font-semibold">Tester la compatibilité</button>
        <p id="simu-result" class="text-xs p-2 rounded-xl bg-slate-50 border hidden"></p>
      </div>
    </div>
    <div class="bg-white rounded-2xl border border-cumulo-border p-5">
      <h3 class="font-bold text-cumulo-blue">Défi code postal</h3>
      <p class="text-sm text-slate-600">Votre territoire vs moyenne nationale. Carte à partager (anonyme) générée en Canvas.</p>
      <button id="canvas-share" class="mt-3 w-full border border-slate-200 rounded-xl py-2 font-semibold hover:bg-slate-50">Générer ma carte à partager</button>
      <canvas id="shareCanvas" width="1200" height="630" class="hidden"></canvas>
      <p class="text-[10px] text-slate-500 mt-2">Aucun nom sur l'image. QR vers Cumuloscope.</p>
    </div>
  </section>

  <!-- Filtre loi 2014 rappel -->
  <section class="max-w-6xl mx-auto px-4 mt-6">
    <div class="bg-white rounded-2xl border border-cumulo-border p-4 flex flex-wrap gap-3 items-center justify-between">
      <div>
        <p class="font-semibold">Filtre d'interprétation</p>
        <p class="text-xs text-slate-600">Par défaut: <strong>cumul large</strong> (≥2 types). Activez le filtre pour ne voir que l' <strong>interdit loi 2014</strong> (parlementaire + exécutif).</p>
      </div>
      <label class="inline-flex items-center gap-2 text-sm border rounded-full px-3 py-1.5 cursor-pointer">
        <input id="filter2014" type="checkbox" class="accent-cumulo-blue" /> Filtre “interdit 2014” uniquement
      </label>
    </div>
  </section>

  <script is:inline define:vars={{ base, national, byDept, timeline }}>
    // Minimal dept search
    const searchInput = document.getElementById('dept-search');
    const goBtn = document.getElementById('dept-go');
    function normalize(s){ return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().trim(); }
    const deptMap = new Map(byDept.map(d=>[d.code, d.libelle]));
    const nameToCode = new Map(byDept.map(d=>[normalize(d.libelle), d.code]));
    function resolveDept(q){
      q = q.trim();
      if(!q) return null;
      // postal code 5 digits -> dept 2 first chars (97x 3)
      if(/^\d{5}$/.test(q)){
        if(q.startsWith('97')) return q.slice(0,3);
        if(q.startsWith('20')){ // Corse split approx
          const n = parseInt(q.slice(0,5),10);
          return n < 20200 ? '2A' : '2B';
        }
        return q.slice(0,2).replace(/^0/,'');
      }
      if(/^(2A|2B|\d{2,3})$/.test(q.toUpperCase())) return q.toUpperCase();
      const n = normalize(q);
      if(nameToCode.has(n)) return nameToCode.get(n);
      // partial
      for(const d of byDept){ if(normalize(d.libelle).includes(n)) return d.code; }
      return null;
    }
    function go(){
      const q = searchInput.value;
      const code = resolveDept(q);
      if(code && deptMap.has(code)) location.href = base + 'departement/' + code + '/';
      else {
        searchInput.classList.add('ring','ring-red-300');
        setTimeout(()=>searchInput.classList.remove('ring','ring-red-300'), 1200);
      }
    }
    goBtn.addEventListener('click', go);
    searchInput.addEventListener('keydown', e=>{ if(e.key==='Enter') go(); });
    document.querySelectorAll('.example-btn').forEach(b=>b.addEventListener('click', ()=>{ searchInput.value = b.dataset.example; go(); }));

    // Simulateur
    const simu1 = document.getElementById('simu1');
    const simu2 = document.getElementById('simu2');
    const simuGo = document.getElementById('simu-go');
    const simuRes = document.getElementById('simu-result');
    function simu(){
      const a = simu1.value, b = simu2.value;
      if(!a || !b) { simuRes.textContent='Choisissez 2 mandats.'; simuRes.classList.remove('hidden'); return; }
      const parl = new Set(['dep','sen']);
      const exec = new Set(['mai','cd','cr']);
      const isParlExec = (parl.has(a) && exec.has(b)) || (parl.has(b) && exec.has(a));
      if(isParlExec){
        simuRes.textContent = '⛔ Incompatible depuis 2017 (loi 2014-125). Un parlementaire ne peut pas exercer de fonction exécutive locale (maire/adj., président/vp).';
        simuRes.className='text-xs p-2 rounded-xl bg-red-50 border border-red-200 text-red-800';
      } else {
        simuRes.textContent = '✅ Compatible à ce jour (définition large). Attention: charge de travail et éthique à considérer.';
        simuRes.className='text-xs p-2 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800';
      }
      simuRes.classList.remove('hidden');
    }
    simuGo.addEventListener('click', simu);

    // Badges/streak from localStorage
    try{
      const badges = JSON.parse(localStorage.getItem('cumuloscope:badges')||'[]');
      document.getElementById('badge-count').textContent = badges.length;
      const streak = JSON.parse(localStorage.getItem('cumuloscope:streak')||'{"count":0}');
      document.getElementById('streak-count').textContent = streak.count || 0;
    }catch{}

    // Share home card via Web Share or canvas
    document.getElementById('share-home').addEventListener('click', ()=>{
      const text = `Cumuloscope: ${national.totalElus.toLocaleString('fr-FR')} élus, ${national.pctCumulLarge}% en cumul large, ${national.pctInterdit2014}% interdit 2014. Et ton département?`;
      if(navigator.share) navigator.share({title:'Cumuloscope', text, url: location.href}).catch(()=>{});
      else { navigator.clipboard.writeText(text + ' ' + location.href); alert('Lien copié !'); }
    });

    // Canvas share
    document.getElementById('canvas-share').addEventListener('click', ()=>{
      const c = document.getElementById('shareCanvas');
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#0f2a44'; ctx.fillRect(0,0,1200,630);
      ctx.fillStyle = '#fff'; ctx.font = 'bold 48px sans-serif'; ctx.fillText('Cumuloscope — Ve République', 40, 80);
      ctx.font = '28px sans-serif'; ctx.fillText(`${national.totalElus.toLocaleString('fr-FR')} élus • ${national.pctCumulLarge}% en cumul large • ${national.pctInterdit2014}% interdit 2014`, 40, 130);
      ctx.fillStyle = '#f2c744'; ctx.font = 'bold 36px sans-serif'; ctx.fillText('Et ton département ?', 40, 280);
      ctx.fillStyle = '#fff'; ctx.font = '20px sans-serif'; ctx.fillText('Données RNE 11/08/2026 • Licence Ouverte • cumuloscope.fr', 40, 580);
      ctx.strokeStyle = '#ffffff33'; ctx.strokeRect(20,20,1160,590);
      c.toBlob(b=>{
        if(b){
          const url = URL.createObjectURL(b);
          const a = document.createElement('a'); a.href = url; a.download = 'cumuloscope-carte.png'; a.click();
          URL.revokeObjectURL(url);
          // badge
          try{
            const badges = new Set(JSON.parse(localStorage.getItem('cumuloscope:badges')||'[]'));
            badges.add('pedagogue'); localStorage.setItem('cumuloscope:badges', JSON.stringify([...badges]));
          }catch{}
        }
      });
    });

    // Filter 2014 toggle -> will recolor map via event
    document.getElementById('filter2014').addEventListener('change', e=>{
      window.dispatchEvent(new CustomEvent('cumulo:filter', {detail:{interditOnly: e.target.checked}}));
    });
    // Expose for module script (map/chart) to avoid define:vars large payload
    window.byDeptData = byDept;
    window.timelineData = timeline;
    window.baseUrl = base;
  </script>

  <!-- Leaflet + Chart.js islands (progressive enhancement) -->
  <script>
    import L from "leaflet";
    import { Chart, registerables } from "chart.js";
    Chart.register(...registerables);

    const base = window.baseUrl || import.meta.env.BASE_URL;
    const byDeptData = window.byDeptData || [];
    const timelineData = window.timelineData || [];

    // Map — vraie choroplèthe GeoJSON (96 départements métropole) + cercles pour DOM
    const map = L.map('map', { zoomControl: false, attributionControl: true }).setView([46.6, 2.5], 5.5);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OSM & Carto &bull; Contours gregoiredavid/france-geojson',
      maxZoom: 8,
      minZoom: 5
    }).addTo(map);

    const centroidsDOM = {
      "971":[16.2,-61.5],"972":[14.6,-61.0],"973":[3.9,-53.1],"974":[-21.1,55.5],"976":[-12.8,45.1]
    };
    let interditOnly = false;
    let geoLayer = null;
    let domMarkers = [];
    const byCode = new Map(byDeptData.map(d=>[d.code, d]));
    function colorForVal(v){
      if(v < 10) return '#fee8c8';
      if(v < 14) return '#fdbb84';
      if(v < 18) return '#fc8d59';
      return '#ef6548';
    }
    function valFor(d){ return interditOnly ? d.pctInterdit2014 : d.pctCumulLarge; }
    function styleFor(feature){
      const code = feature.properties.code;
      const d = byCode.get(code);
      const v = d ? valFor(d) : 0;
      return { fillColor: colorForVal(v), weight: 0.8, color: '#fff', fillOpacity: 0.88, opacity: 1 };
    }
    function renderDOM(){
      domMarkers.forEach(m=> map.removeLayer(m)); domMarkers=[];
      ["971","972","973","974","976"].forEach(code=>{
        const d = byCode.get(code); if(!d) return;
        const c = centroidsDOM[code]; if(!c) return;
        const v = valFor(d);
        const col = colorForVal(v);
        const mk = L.circleMarker(c, { radius: 9, fillColor: col, color: '#0f2a44', weight: 1.5, fillOpacity: 0.95 })
          .addTo(map)
          .bindTooltip(`<b>${d.code} — ${d.libelle}</b><br/>${d.totalElus.toLocaleString('fr-FR')} élus<br/>${d.pctCumulLarge}% cumul large<br/>${d.pctInterdit2014}% interdit`, {direction:'top'});
        mk.on('click', ()=> location.href = base + 'departement/' + d.code + '/');
        domMarkers.push(mk);
      });
    }
    // Fetch GeoJSON contours
    fetch(base + 'topo/departements.geojson')
      .then(r=> r.json())
      .then(geo=>{
        geoLayer = L.geoJSON(geo, {
          style: styleFor,
          onEachFeature: (feature, layer)=>{
            const code = feature.properties.code;
            const d = byCode.get(code);
            if(!d) return;
            layer.bindTooltip(`<b>${d.code} — ${d.libelle}</b><br/>${d.totalElus.toLocaleString('fr-FR')} élus<br/>${d.pctCumulLarge}% cumul large<br/>${d.pctInterdit2014}% interdit 2014`, {sticky:true});
            layer.on('click', ()=> location.href = base + 'departement/' + code + '/');
            layer.on('mouseover', e=>{ e.target.setStyle({weight:2, color:'#0f2a44'}); });
            layer.on('mouseout', e=>{ geoLayer.resetStyle(e.target); });
          }
        }).addTo(map);
        try{ map.fitBounds(geoLayer.getBounds(), {padding:[10,10]}); }catch(e){}
        renderDOM();
      })
      .catch(err=>{
        console.warn('GeoJSON load fail, fallback markers', err);
        // Fallback to old circleMarkers for all
        const centroidsAll = {
