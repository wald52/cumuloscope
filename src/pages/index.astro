      const datasets = [
        { label: '% cumul large (est.)', data: timelineData.map(t=>t.pctCumul), borderColor: '#0f2a44', backgroundColor: 'rgba(15,42,68,0.08)', tension: 0.3, fill: false, pointRadius: 3, borderDash:[4,3] },
